PORT=3001
# Optional private RPC endpoints. Never use VITE_ prefix for RPC credentials.
MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
DEVNET_RPC_URL=https://api.devnet.solana.com
# Optional ordered fallback lists: comma-separated or newline-separated, max 4.
# A nonempty list replaces the matching single URL; it does not merge with it.
# Configure these only on the server. Token lookup requires filtered getProgramAccounts.
# MAINNET_RPC_URLS=https://api.mainnet-beta.solana.com,https://your-mainnet-rpc.example
# DEVNET_RPC_URLS=https://api.devnet.solana.com,https://your-devnet-rpc.example
# Official Solana public endpoints share a bounded 2 requests/second queue.
# Optional operator override: positive number <= 100; private RPC is ungated by default.
# RPC_REQUESTS_PER_SECOND=2
